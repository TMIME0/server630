<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة الإمداد والجيوش - التحالف</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #121212;
            color: #e5e7eb;
        }
        .gold-border { border-color: #d4af37; }
        .gold-text { color: #d4af37; }
        .gold-bg { background-color: #d4af37; }
        .slate-card {
            background-color: #1e1e24;
            border: 1px solid #2d2d38;
        }
        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-center p-4">

    <!-- شاشة تسجيل الدخول -->
    <div id="login-screen" class="slate-card p-8 rounded-3xl shadow-2xl w-full max-w-md text-center border gold-border">
        <h2 class="text-2xl font-black gold-text mb-6">تسجيل دخول الإمداد</h2>
        <div class="space-y-4">
            <div>
                <input type="text" id="login-code" placeholder="كود الأدمن (مثال: 1G630)" 
                    class="w-full px-4 py-3 rounded-2xl bg-[#121212] border border-[#3f3f46] text-white focus:outline-none focus:border-[#d4af37]">
            </div>
            <div>
                <input type="password" id="login-pass" placeholder="رمز القلعة / المرور" 
                    class="w-full px-4 py-3 rounded-2xl bg-[#121212] border border-[#3f3f46] text-white focus:outline-none focus:border-[#d4af37]">
            </div>
            <button type="button" onclick="handleLogin()" class="w-full py-3 rounded-2xl gold-bg text-black font-bold hover:opacity-90 transition shadow-lg cursor-pointer">
                دخول للقلعة
            </button>
        </div>

        <!-- زر الانتقال لتسجيل دخول الأعضاء -->
        <div class="mt-4 pt-4 border-t border-gray-800 text-center">
            <button type="button" onclick="toggleMemberLogin()" class="text-xs gold-text underline hover:opacity-80 cursor-pointer">
                هل أنت عضو؟ اضغط هنا لدخول قلعتك الخاصة
            </button>
        </div>

        <!-- نموذج دخول العضو (مخفي بالبداية) -->
        <div id="member-login-box" class="hidden mt-4 space-y-3 p-4 bg-[#121212] rounded-2xl border border-gray-800 text-right">
            <h3 class="text-sm font-bold text-white mb-2">دخول الأعضاء (عرض القلعة فقط)</h3>
            <input type="text" id="member-num-input" placeholder="رقم العضو (مثال: 1)" 
                class="w-full px-3 py-2 rounded-xl bg-[#1e1e24] border border-gray-700 text-xs text-white focus:outline-none focus:border-[#d4af37]">
            <input type="password" id="member-pass-input" placeholder="رمز القلعة (مثال: pass1)" 
                class="w-full px-3 py-2 rounded-xl bg-[#1e1e24] border border-gray-700 text-xs text-white focus:outline-none focus:border-[#d4af37]">
            <button type="button" onclick="handleMemberLogin()" class="w-full py-2 rounded-xl bg-gray-800 hover:bg-[#d4af37] hover:text-black text-xs font-bold transition cursor-pointer">
                دخول قلعتي
            </button>
        </div>

        <!-- رسالة الترحيب -->
        <div id="welcome-msg" class="mt-4 text-red-500 font-bold text-lg hidden flex items-center justify-center gap-1">
            مليون هلا <span class="text-xl">❤️</span>
        </div>
    </div>

    <!-- لوحة التحكم الرئيسية لإدارة الإمداد -->
    <div id="dashboard" class="hidden w-full max-w-7xl mx-auto space-y-6">
        <!-- هيدر الموقع -->
        <header class="slate-card p-6 rounded-3xl flex flex-col md:flex-row justify-between items-center border gold-border gap-4">
            <div>
                <h1 class="text-2xl font-black gold-text">لوحة إمداد وتحالف الجيوش</h1>
                <p id="admin-role-title" class="text-sm text-gray-400">لوحة القيادة والسيطرة</p>
            </div>
            <div class="flex flex-col md:flex-row items-center gap-4">
                <div id="user-info" class="bg-[#121212] px-4 py-2 rounded-xl border border-gray-800 text-xs gold-text font-bold">
                    مرحباً بك
                </div>
                <button type="button" onclick="logout()" class="px-4 py-2 bg-red-600/80 hover:bg-red-600 text-white rounded-xl text-xs font-bold transition shadow cursor-pointer">
                    تسجيل خروج 🚪
                </button>
            </div>
        </header>

        <!-- زر إعدادات الأعضاء الخاص بالأدمن العام فقط -->
        <div id="master-admin-settings-container" class="hidden">
            <button type="button" onclick="toggleSettingsModal()" class="px-5 py-2.5 gold-bg text-black font-bold rounded-xl text-xs hover:opacity-90 transition shadow cursor-pointer flex items-center gap-2">
                ⚙️ إدارة وتعديل يوزرات ورموز الأعضاء (للأدمن العام فقط)
            </button>
        </div>

        <!-- قسم الإحصائيات الكلية (الأسفل) -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="slate-card p-4 rounded-2xl border border-gray-800 text-center shadow-md">
                <span class="text-gray-400 text-xs block mb-1">مدرع رماة (قوس)</span>
                <span id="total-armored-archers" class="text-2xl font-black gold-text">0</span>
            </div>
            <div class="slate-card p-4 rounded-2xl border border-gray-800 text-center shadow-md">
                <span class="text-gray-400 text-xs block mb-1">مدرع مشاة (سيف)</span>
                <span id="total-armored-infantry" class="text-2xl font-black gold-text">0</span>
            </div>
            <div class="slate-card p-4 rounded-2xl border border-gray-800 text-center shadow-md">
                <span class="text-gray-400 text-xs block mb-1">خارق رماة (قوس)</span>
                <span id="total-super-archers" class="text-2xl font-black gold-text">0</span>
            </div>
            <div class="slate-card p-4 rounded-2xl border border-gray-800 text-center shadow-md">
                <span class="text-gray-400 text-xs block mb-1">خارق مشاة (سيف)</span>
                <span id="total-super-infantry" class="text-2xl font-black gold-text">0</span>
            </div>
            <div class="slate-card p-4 rounded-2xl border gold-border text-center shadow-md bg-[#1e1e24]/80">
                <span class="gold-text text-xs block mb-1 font-bold">✨ بلور النيزك الكلي</span>
                <span id="total-meteor-crystal" class="text-2xl font-black gold-text">0</span>
            </div>
        </section>

        <!-- جدول الأعضاء والجيوش (مع خانة البحث وبلور النيزك والاعتمادات) -->
        <section class="slate-card p-6 rounded-3xl border gold-border space-y-4">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                <h3 class="text-xl font-bold gold-text">سجل الإمداد وقلاع الأعضاء</h3>
                <!-- خانة البحث السريع -->
                <div class="w-full md:w-72">
                    <input type="text" id="search-input" onkeyup="filterTable()" placeholder="ابحث عن اسم القلعة (مثال: سفاح)..." 
                        class="w-full px-4 py-2 rounded-xl bg-[#121212] border border-gray-700 text-sm text-white focus:outline-none focus:border-[#d4af37]">
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-right border-collapse min-w-[900px]">
                    <thead>
                        <tr class="border-b border-gray-800 text-gray-400 text-sm">
                            <th class="p-3">العضو / القلعة والبيانات</th>
                            <th class="p-3 text-center">الأنواع (⚔️ / 🏹)</th>
                            <th class="p-3">مدرع (مشاة / رماة)</th>
                            <th class="p-3">خارق (مشاة / رماة)</th>
                            <th class="p-3">✨ بلور النيزك</th>
                            <th class="p-3 text-center">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="members-table-body">
                        <!-- يتم تعبئتها ديناميكياً -->
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <!-- نافذة إعدادات الأعضاء (للأدمن العام فقط) -->
    <div id="settings-modal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center p-4 z-50">
        <div class="slate-card p-6 rounded-3xl border gold-border w-full max-w-4xl max-h-[85vh] overflow-y-auto space-y-4">
            <div class="flex justify-between items-center border-b border-gray-800 pb-3">
                <h3 class="text-lg font-bold gold-text">إدارة وتعديل يوزرات ورموز أعضاء التحالف</h3>
                <button type="button" onclick="toggleSettingsModal()" class="text-gray-400 hover:text-white font-bold text-lg cursor-pointer">✕</button>
            </div>
            <p class="text-xs text-gray-400">من هنا تقدر تغير يوزر (ايميل) ورمز أي عضو، والتغيير بينحفظ مباشرة بالنظام!</p>
            
            <div id="settings-members-list" class="space-y-3">
                <!-- يتم تعبئتها تلقائياً -->
            </div>
            
            <div class="text-left pt-4">
                <button type="button" onclick="saveAllMembersChanges()" class="px-6 py-2 gold-bg text-black font-bold rounded-xl text-xs cursor-pointer">
                    حفظ التعديلات العامة
                </button>
            </div>
        </div>
    </div>

    <script>
        const admins = {
            "1G630": { name: "الأدمن الأول (مدير عام)", pass: "Tmime9090", isMaster: true },
            "2G630": { name: "الأدمن الثاني", pass: "pass2", isMaster: false },
            "3G630": { name: "الأدمن الثالث", pass: "pass3", isMaster: false },
            "4G630": { name: "الأدمن الرابع", pass: "pass4", isMaster: false },
            "5G630": { name: "الأدمن الخامس", pass: "pass5", isMaster: false }
        };

        let currentAdmin = null;

        // تهيئة بيانات الأعضاء الـ 75 في التخزين المحلي (LocalStorage)
        let membersData = JSON.parse(localStorage.getItem('alliance_members')) || [];
        if (membersData.length === 0) {
            for (let i = 1; i <= 75; i++) {
                membersData.push({
                    id: i,
                    castleName: i === 1 ? 'قلعة سفاح' : '',
                    email: `member${i}@alliance.com`,
                    pass: `pass${i}`,
                    infantryArmored: 0,
                    archerArmored: 0,
                    infantrySuper: 0,
                    archerSuper: 0,
                    meteor: 0
                });
            }
            localStorage.setItem('alliance_members', JSON.stringify(membersData));
        }

        function handleLogin() {
            const code = document.getElementById('login-code').value.trim();
            const pass = document.getElementById('login-pass').value.trim();
            const welcomeMsg = document.getElementById('welcome-msg');

            if (admins[code] && admins[code].pass === pass) {
                currentAdmin = admins[code];
                welcomeMsg.classList.remove('hidden');

                setTimeout(() => {
                    document.getElementById('login-screen').classList.add('hidden');
                    document.getElementById('dashboard').classList.remove('hidden');
                    document.getElementById('user-info').innerText = currentAdmin.name;
                    document.getElementById('admin-role-title').innerText = currentAdmin.isMaster ? 'صلاحيات كاملة (تحكم بالرموز والجيوش والإعدادات)' : 'صلاحيات اطلاع وتعديل الجيش';
                    
                    if (currentAdmin.isMaster) {
                        document.getElementById('master-admin-settings-container').classList.remove('hidden');
                    } else {
                        document.getElementById('master-admin-settings-container').classList.add('hidden');
                    }

                    initMembersTable();
                }, 1000);
            } else {
                alert('الكود أو الرمز غير صحيح! تأكد من البيانات.');
            }
        }

        function toggleMemberLogin() {
            const box = document.getElementById('member-login-box');
            box.classList.toggle('hidden');
        }

        function handleMemberLogin() {
            const mNum = Number(document.getElementById('member-num-input').value.trim());
            const mPass = document.getElementById('member-pass-input').value.trim();

            const member = membersData.find(m => m.id === mNum && m.pass === mPass);

            if (member) {
                document.getElementById('login-screen').classList.add('hidden');
                document.getElementById('dashboard').classList.remove('hidden');
                document.getElementById('user-info').innerText = 'عضو رقم ' + mNum;
                document.getElementById('admin-role-title').innerText = 'لوحة قلعتك الخاصة (عرض وتعديل بياناتك)';
                document.getElementById('master-admin-settings-container').classList.add('hidden');
                
                initMembersTable();

                setTimeout(() => {
                    document.getElementById('search-input').value = 'عضو رقم ' + mNum;
                    filterTable();
                }, 100);
            } else {
                alert('رقم العضو أو رمز القلعة غير صحيح!');
            }
        }

        function toggleSettingsModal() {
            const modal = document.getElementById('settings-modal');
            modal.classList.toggle('hidden');
            if (!modal.classList.contains('hidden')) {
                renderSettingsList();
            }
        }

        function renderSettingsList() {
            const container = document.getElementById('settings-members-list');
            container.innerHTML = '';

            membersData.forEach((m, index) => {
                container.innerHTML += `
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-2 p-3 bg-[#121212] rounded-xl border border-gray-800 items-center">
                        <span class="text-xs font-bold text-white">عضو رقم ${m.id}</span>
                        <input type="text" id="set-email-${index}" value="${m.email}" placeholder="اليوزر / الايميل" 
                            class="px-3 py-1.5 bg-[#1e1e24] border border-gray-700 rounded-lg text-xs text-white focus:outline-none focus:border-[#d4af37]">
                        <input type="text" id="set-pass-${index}" value="${m.pass}" placeholder="الرمز السري" 
                            class="px-3 py-1.5 bg-[#1e1e24] border border-gray-700 rounded-lg text-xs gold-text font-bold focus:outline-none focus:border-[#d4af37]">
                        <span class="text-[10px] text-gray-400">القلعة: ${m.castleName || 'بدون'}</span>
                    </div>
                `;
            });
        }

        function saveAllMembersChanges() {
            membersData.forEach((m, index) => {
                const newEmail = document.getElementById(`set-email-${index}`).value.trim();
                const newPass = document.getElementById(`set-pass-${index}`).value.trim();
                if (newEmail) m.email = newEmail;
                if (newPass) m.pass = newPass;
            });

            localStorage.setItem('alliance_members', JSON.stringify(membersData));
            alert('تم حفظ تعديلات حسابات الأعضاء بنجاح!');
            toggleSettingsModal();
            initMembersTable();
        }

        function logout() {
            document.getElementById('dashboard').classList.add('hidden');
            document.getElementById('login-screen').classList.remove('hidden');
            document.getElementById('login-code').value = '';
            document.getElementById('login-pass').value = '';
            document.getElementById('member-num-input').value = '';
            document.getElementById('member-pass-input').value = '';
            document.getElementById('welcome-msg').classList.add('hidden');
            document.getElementById('search-input').value = '';
        }

        function initMembersTable() {
            const tbody = document.getElementById('members-table-body');
            tbody.innerHTML = '';

            membersData.forEach((m) => {
                const tr = document.createElement('tr');
                tr.className = 'member-row border-b border-gray-800/40 hover:bg-white/5 transition';
                
                tr.innerHTML = `
                    <td class="p-3 space-y-2">
                        <div class="font-bold text-white text-sm">عضو رقم ${m.id}</div>
                        <input type="text" placeholder="اسم القلعة (مثل: سفاح)" value="${m.castleName}" 
                            class="castle-name-input px-3 py-1.5 bg-[#121212] border border-gray-700 rounded-xl text-xs text-white focus:outline-none focus:border-[#d4af37] w-full"
                            oninput="updateCastleName(${m.id}, this.value)">
                        <div class="bg-[#121212] p-2 rounded-xl border border-gray-800 space-y-1">
                            <p class="text-[11px] text-gray-400">الايميل: ${m.email}</p>
                            <p class="text-[11px] gold-text font-bold">رمز القلعة: ${m.pass}</p>
                        </div>
                    </td>
                    <td class="p-3 text-center text-lg select-none">
                        ⚔️ 🏹
                    </td>
                    <td class="p-3">
                        <div class="flex gap-2">
                            <input type="number" placeholder="مشاة" value="${m.infantryArmored || ''}" class="w-24 bg-[#121212] border border-gray-700 rounded-xl p-2 text-sm text-center text-white focus:outline-none focus:border-[#d4af37]" oninput="updateMemberData(${m.id}, 'infantryArmored', this.value)">
                            <input type="number" placeholder="رماة" value="${m.archerArmored || ''}" class="w-24 bg-[#121212] border border-gray-700 rounded-xl p-2 text-sm text-center text-white focus:outline-none focus:border-[#d4af37]" oninput="updateMemberData(${m.id}, 'archerArmored', this.value)">
                        </div>
                    </td>
                    <td class="p-3">
                        <div class="flex gap-2">
                            <input type="number" placeholder="مشاة" value="${m.infantrySuper || ''}" class="w-24 bg-[#121212] border border-gray-700 rounded-xl p-2 text-sm text-center text-white focus:outline-none focus:border-[#d4af37]" oninput="updateMemberData(${m.id}, 'infantrySuper', this.value)">
                            <input type="number" placeholder="رماة" value="${m.archerSuper || ''}" class="w-24 bg-[#121212] border border-gray-700 rounded-xl p-2 text-sm text-center text-white focus:outline-none focus:border-[#d4af37]" oninput="updateMemberData(${m.id}, 'archerSuper', this.value)">
                        </div>
                    </td>
                    <td class="p-3">
                        <input type="number" placeholder="كمية النيزك" value="${m.meteor || ''}" class="w-28 bg-[#121212] border border-gray-700 rounded-xl p-2 text-sm text-center gold-text font-bold focus:outline-none focus:border-[#d4af37]" oninput="updateMemberData(${m.id}, 'meteor', this.value)">
                    </td>
                    <td class="p-3 text-center">
                        <button type="button" onclick="alert('تم حفظ إمداد القلعة بنجاح')" class="px-4 py-2 bg-gray-800 hover:bg-[#d4af37] hover:text-black rounded-xl text-xs font-bold transition shadow cursor-pointer">حفظ</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
            calculateTotals();
        }

        function updateCastleName(id, val) {
            const member = membersData.find(m => m.id === id);
            if (member) {
                member.castleName = val;
                localStorage.setItem('alliance_members', JSON.stringify(membersData));
                filterTable();
            }
        }

        function updateMemberData(id, field, val) {
            const member = membersData.find(m => m.id === id);
            if (member) {
                member[field] = Number(val) || 0;
                localStorage.setItem('alliance_members', JSON.stringify(membersData));
                calculateTotals();
            }
        }

        function filterTable() {
            const query = document.getElementById('search-input').value.toLowerCase().trim();
            const rows = document.querySelectorAll('.member-row');

            rows.forEach(row => {
                const castleInput = row.querySelector('.castle-name-input').value.toLowerCase();
                const memberText = row.innerText.toLowerCase();

                if (castleInput.includes(query) || memberText.includes(query)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function calculateTotals() {
            let totalArmoredArchers = 0;
            let totalArmoredInfantry = 0;
            let totalSuperArchers = 0;
            let totalSuperInfantry = 0;
            let totalMeteor = 0;

            membersData.forEach(m => {
                totalArmoredArchers += m.archerArmored || 0;
                totalArmoredInfantry += m.infantryArmored || 0;
                totalSuperArchers += m.archerSuper || 0;
                totalSuperInfantry += m.infantrySuper || 0;
                totalMeteor += m.meteor || 0;
            });

            document.getElementById('total-armored-archers').innerText = totalArmoredArchers.toLocaleString();
            document.getElementById('total-armored-infantry').innerText = totalArmoredInfantry.toLocaleString();
            document.getElementById('total-super-archers').innerText = totalSuperArchers.toLocaleString();
            document.getElementById('total-super-infantry').innerText = totalSuperInfantry.toLocaleString();
            document.getElementById('total-meteor-crystal').innerText = totalMeteor.toLocaleString();
        }
    </script>
</body>
</html>